{
  "expo": {
    "name": "GymFor",
    "slug": "GymFor",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "scheme": "gymsfor",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gymfor.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.gymfor.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GymFor accede a tu galería para asociar imágenes personalizadas a los ejercicios de tus rutinas.",
          "cameraPermission": "GymFor accede a tu cámara para tomar fotos personalizadas de tus ejercicios.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5b95289c-be2c-4d1f-89d0-1075b26079bc"
      }
    }
  }
}
