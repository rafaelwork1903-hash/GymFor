{
  "name": "gymfor",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@tamagui/config": "^2.7.7",
    "@tamagui/font-inter": "^2.7.7",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.0.1",
    "babel-preset-expo": "~58.0.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-svg-transformer": "^1.5.3",
    "react-native-web": "^0.21.4",
    "tamagui": "^2.7.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tamagui/babel-plugin": "^2.7.7",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "expo-constants": "~58.0.15",
    "react-native-web": "^0.21.4"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "build:preview": "bunx eas-cli build --profile preview --platform android",
    "build:ios": "bunx eas-cli build --profile preview --platform ios",
    "eas:doctor": "bunx expo-doctor"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest-setup.ts"
    ],
    "moduleNameMapper": {
      "^react-native/react-private-interface$": "<rootDir>/node_modules/react-native/src/react-private-interface.js",
      "\\.svg$": "<rootDir>/__mocks__/svgMock.js"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/helpers/"
    ]
  },
  "private": true,
  "trustedDependencies": [
    "unrs-resolver"
  ]
}